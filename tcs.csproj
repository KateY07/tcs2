<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>tcs</AssemblyName>
    <RootNamespace>Tcs</RootNamespace>
    <!--
      Framework-dependent by design: this machine already has the .NET 10
      runtime installed, so we do not publish self-contained. A plain
      `dotnet build` (or `dotnet publish`, still framework-dependent unless
      you explicitly pass the self-contained option) produces tcs.exe under
      bin/<Config>/net10.0/ that runs against the installed runtime.
    -->
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- No extra NuGet packages: everything used here ships in the
         Microsoft.NET.Sdk.Web / ASP.NET Core shared framework. -->
    <Content Remove="keys\**" />
    <Content Remove="uploads\**" />
    <Content Remove="test-logs\**" />
    <Content Remove="_package\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
